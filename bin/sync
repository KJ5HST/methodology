#!/usr/bin/env python3
"""Sync methodology starter-kit files into a project.

Contract: methodology v2.2 plan §4D. A project keeps its methodology files either at its root (the legacy
layout, bin/_manifest.py's `dest` column) or one level down in methodology/ (the new layout, its NEW_LAYOUT
table); BL-101 phase P6, docs/planning/methodology-subdirectory-plan.md section 5A. `--layout auto` (the
default) keeps a project in the layout it has and gives an empty directory the legacy default, which flips
only at the contract release. A request that would put a second copy of the files beside the first is
refused before anything is written, and so is a tree that holds the runner in both places.
"""
import argparse
import hashlib
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from _manifest import DISTRIBUTION, TRACKED, SEED, NEW_LAYOUT  # noqa: E402  (bin/ on sys.path)
from _manifest_reader import ManifestError, read_manifest, read_new_layout  # noqa: E402

# A project keeps its methodology files at its root (legacy) or under methodology/ (new): the plan's
# section 4.3. This block is the resolver, embedded byte for byte; the canonical suite asserts that.

# --- layout resolver: BEGIN ---
import os as _os
from pathlib import Path as _Path


def resolve_layout(root, anchor="SESSION_RUNNER.md"):
    """Return (kind, directory, found): kind is new|legacy|half|none, directory a Path or None,
    found the anchor paths that exist. A half-migrated tree has no directory, by design.
    A file found in both places is the framework's under methodology/ when the runner is under
    methodology/ and not at the root: the root copy is the project's own and is left alone, kind new,
    and found still names both. Any other tie stays half, and the runner cannot decide a tie about itself."""
    root = _Path(root)
    new, old = root / "methodology" / anchor, root / anchor
    found = tuple(p for p in (new, old) if _os.path.isfile(p))
    if len(found) == 2:
        if _os.path.isfile(root / "methodology" / "SESSION_RUNNER.md") and not _os.path.isfile(root / "SESSION_RUNNER.md"):
            return "new", new.parent, found
        return "half", None, found
    if not found:
        return "none", None, ()
    return ("new", new.parent, found) if found[0] == new else ("legacy", root, found)
# --- layout resolver: END ---


REPO = "KJ5HST/methodology"
# --source=github clones this URL; the variable overrides it (a private mirror, or a local bare
# repository in bin/tests.sh). Anything `git clone` accepts: a URL or a path.
SOURCE_URL_ENV = "METHODOLOGY_SOURCE_URL"
LAYOUTS = ("auto", "legacy", "new")
# The tool that moves a project from the legacy layout to the new one (BL-101 phase P7): a dry run unless --apply.
MIGRATE_TOOL = "bin/migrate-layout"


def rows_for(layout: str) -> list:
    """Every distributed file as (src, dest, disposition), with dest where `layout` puts it."""
    if layout == "legacy":
        return list(DISTRIBUTION)
    return [(src, NEW_LAYOUT[src], disp) for src, _dest, disp in DISTRIBUTION]


# Only TRACKED dests are gitignored (ignore mode) and checked for accidental git
# tracking. SEED files become adopter-owned after first creation and are meant to
# be committed, so they are deliberately excluded from both.
def tracked_dests(layout: str) -> tuple:
    return tuple(dest for _src, dest, disp in rows_for(layout) if disp == TRACKED)


def ignore_entries(layout: str) -> tuple:
    return tuple(f"/{dest}" for dest in tracked_dests(layout))


def script_methodology_root() -> Path:
    # This script lives at <methodology>/bin/sync.
    return Path(__file__).resolve().parent.parent


def detect_mode(project: Path) -> str:
    gitignore = project / ".gitignore"
    if not gitignore.exists():
        return "commit"
    existing = set(line.strip() for line in gitignore.read_text().splitlines())
    # an ignored project is recognised by either layout's entries: it may have been synced before it moved
    entries = ignore_entries("legacy") + (ignore_entries("new") if NEW_LAYOUT else ())
    if any(entry in existing for entry in entries):
        return "ignore"
    return "commit"


def detect_source(methodology_root: Path) -> str:
    if (methodology_root / "starter-kit").is_dir():
        return "local"
    return "github"


def blob_sha(content: bytes) -> str:
    header = f"blob {len(content)}\0".encode()
    return hashlib.sha1(header + content).hexdigest()


def read_local(methodology_root: Path, src: str) -> bytes:
    return (methodology_root / src).read_bytes()


def local_history_blobs(methodology_root: Path, src: str) -> set:
    """Set of blob SHAs this file has had across methodology git history.

    --full-history, because git's default walk follows only a merge's TREESAME parent: a version
    on the side a merge did not keep was never visited, so an unmodified copy of it was refused
    as a local modification."""
    path = src
    try:
        log = subprocess.run(
            ["git", "-C", str(methodology_root), "log", "--full-history", "--format=%H", "--", path],
            capture_output=True, text=True, check=True,
        ).stdout.strip().splitlines()
    except (FileNotFoundError, subprocess.CalledProcessError):
        return set()
    if not log:
        return set()
    # One batched lookup rather than a git ls-tree per commit: the full walk visits over twice
    # the commits the default walk did, and a subprocess each more than doubled the run time.
    try:
        out = subprocess.run(
            ["git", "-C", str(methodology_root), "cat-file", "--batch-check=%(objectname) %(objecttype)"],
            input="".join(f"{commit}:{path}\n" for commit in log),
            capture_output=True, text=True, check=True,
        ).stdout.splitlines()
    except subprocess.CalledProcessError:
        return set()
    blobs = set()
    for line in out:
        # "<sha> blob", or "<commit>:<path> missing"
        parts = line.split()
        if len(parts) == 2 and parts[1] == "blob":
            blobs.add(parts[0])
    return blobs


def source_url() -> str:
    return os.environ.get(SOURCE_URL_ENV) or f"https://github.com/{REPO}.git"


def clone_source(url: str, parent: Path) -> Path:
    """A full, non-bare clone of url's default branch under parent, for --source=github.

    Full because the history is the point: a file that is merely behind is recognized by
    matching one of the source's past versions (local_history_blobs), and contents alone
    cannot do that. The caller owns parent and removes it, clone and all, when the run ends."""
    clone = parent / "methodology"
    try:
        subprocess.run(["git", "clone", "--quiet", url, str(clone)],
                       capture_output=True, text=True, check=True)
    except FileNotFoundError:
        sys.exit("error: git not found; --source=github clones the methodology repository with git")
    except subprocess.CalledProcessError as e:
        sys.exit(f"error: could not clone {url}: {e.stderr.strip()}\n"
                 f"hint: check the network, or sync from a full local checkout with --source=local")
    return clone


def source_distribution(methodology_root: Path, url: str) -> tuple:
    """The distribution manifest AT THE SOURCE: the clone's own bin/_manifest.py, so the file
    list and the file contents come from one ref (parallel-sessions plan, D8). Iterating THIS
    checkout's manifest against a clone of `main` made every branch that adds a distributed file
    unsyncable from github until it merged -- and left a stale checkout blind to files `main` has
    added since. A source with no manifest of its own falls back to this checkout's.

    Read as data, never run (_manifest_reader), and every row checked before anything is written:
    a disposition other than this checkout's TRACKED and SEED -- which sync_from tests -- or a path
    that leaves the source or the project refuses the run, naming the rows. Returns (rows, table): the
    table is the source's NEW_LAYOUT, or None for a source that predates the new layout, which can
    serve a legacy project and nothing else."""
    path = methodology_root / "bin" / "_manifest.py"
    if not path.is_file():
        return DISTRIBUTION, NEW_LAYOUT
    try:
        rows, _markers = read_manifest(path, (TRACKED, SEED))
        table = read_new_layout(path, rows)
    except ManifestError as e:
        sys.exit(f"error: the bin/_manifest.py in {url} {e}\n"
                 f"hint: nothing was written. A source newer than this checkout may use a format this "
                 f"bin/sync predates: update this checkout,\n"
                 f"      or sync from a full local checkout instead — `--source=local`.")
    return rows, table


def use_distribution(dist: list, table) -> None:
    """Rebind this script's manifest-derived globals to the source's rows and layout table for the rest of the run."""
    global DISTRIBUTION, NEW_LAYOUT
    DISTRIBUTION = dist
    NEW_LAYOUT = table


def note_local_only(local: list, url: str) -> None:
    """Name the rows this checkout's manifest has and the source's does not: they ship in a
    version the source has not merged yet, so they are skipped rather than refused."""
    theirs = {src for src, _dest, _disp in DISTRIBUTION}
    mine = [src for src, _dest, _disp in local if src not in theirs]
    if mine:
        print(f"note: {len(mine)} file(s) in this checkout's manifest are not distributed by {url} yet "
              f"-- skipped, the source's own manifest is what this run installs:")
        for src in mine:
            print(f"    {src}")


def absent_sources(methodology_root: Path, url: str) -> None:
    """Exit, naming every distributed file the cloned source lacks, before anything is written.

    Checked against the SOURCE's own manifest (source_distribution): a file that manifest names
    and the source does not contain is a broken source, not a fault in the project, so no
    complete update is available from it."""
    srcs = [src for src, _dest, _disp in DISTRIBUTION]
    absent = [src for src in srcs if not (methodology_root / src).is_file()]
    if absent:
        listed = "\n".join(f"    {src}" for src in absent)
        sys.exit(f"error: {len(absent)} of {len(srcs)} distributed file(s) do not exist in {url} yet:\n"
                 f"{listed}\n"
                 f"       The other {len(srcs) - len(absent)} file(s) are there. That repository's "
                 f"own manifest names files it does not contain,\n"
                 f"       so no complete update is available from it.\n"
                 f"hint: sync from a full local checkout instead — `--source=local` — or wait for "
                 f"upstream to merge.")


def methodology_version(methodology_root: Path) -> str:
    try:
        out = subprocess.run(
            ["git", "-C", str(methodology_root), "describe", "--tags", "--always"],
            capture_output=True, text=True, check=True,
        ).stdout.strip()
        return out or "local"
    except (FileNotFoundError, subprocess.CalledProcessError):
        return "local"


def git_out(methodology_root: Path, *args: str) -> str:
    """One git command's stripped stdout in methodology_root, or "" if git fails or is absent."""
    try:
        return subprocess.run(["git", "-C", str(methodology_root), *args],
                              capture_output=True, text=True, check=True).stdout.strip()
    except (FileNotFoundError, subprocess.CalledProcessError):
        return ""


def history_gap(methodology_root: Path, source: str) -> list:
    """Why this source cannot tell a file that is merely behind from a local edit: the lines
    that say so, or [] when its history is all there.

    A tracked file matching no version in the source's history is a local edit only if that
    history is complete. A shallow clone holds its last commits and a downloaded tree (git
    archive, a release tarball) holds none, so an unmodified older copy matches nothing too."""
    if not (methodology_root / ".git").exists():
        return ["  This source cannot tell whether they are merely behind or edited here:",
                f"  it has no git history (no .git in {methodology_root}), so every version but",
                "  the canonical one matches nothing, and is refused as if it had been edited.",
                "  Clone the repository rather than downloading it, and run from the clone:",
                f"    git clone {source_url()}"]
    if git_out(methodology_root, "rev-parse", "--is-shallow-repository") != "true":
        return []
    n = git_out(methodology_root, "rev-list", "--count", "HEAD")
    lines = ["  This source cannot tell whether they are merely behind or edited here:",
             f"  its checkout is shallow ({n} commit{'' if n == '1' else 's'}), so a version older than the",
             "  commits it holds matches nothing, and is refused as if it had been edited."]
    if source == "local":
        return lines + ["  Run from a full clone, or deepen this one:",
                        f"    git -C {methodology_root} fetch --unshallow"]
    return lines + ["  Sync from a full clone of it instead, with --source=local."]


def ensure_gitignore_entries(project: Path, dry_run: bool, layout: str) -> list:
    gitignore = project / ".gitignore"
    current = gitignore.read_text().splitlines() if gitignore.exists() else []
    existing = set(line.strip() for line in current)
    to_add = [e for e in ignore_entries(layout) if e not in existing]
    if not to_add:
        return []
    if dry_run:
        return to_add
    with gitignore.open("a") as f:
        if current and current[-1].strip() != "":
            f.write("\n")
        f.write("# Methodology files (synced from ../methodology/; run ../methodology/bin/sync .)\n")
        for entry in to_add:
            f.write(entry + "\n")
    return to_add


def currently_tracked(project: Path, layout: str) -> list:
    try:
        out = subprocess.run(
            ["git", "-C", str(project), "ls-files", "--error-unmatch", "--", *tracked_dests(layout)],
            capture_output=True, text=True, check=False,
        )
    except FileNotFoundError:
        return []
    return [line for line in out.stdout.splitlines() if line]


def classify_target(target: Path, canonical_content: bytes, history_blobs: set) -> str:
    """Return 'missing', 'current', 'upgradable', or 'modified'."""
    if not target.exists():
        return "missing"
    current = target.read_bytes()
    if current == canonical_content:
        return "current"
    if blob_sha(current) in history_blobs:
        return "upgradable"
    return "modified"


def sync_file(project: Path, dest: str, content: bytes, dry_run: bool) -> str:
    target = project / dest
    if target.exists() and target.read_bytes() == content:
        return "unchanged"
    action = "would write" if dry_run else ("updated" if target.exists() else "created")
    if not dry_run:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(content)
        if dest.endswith(".py"):
            mode = target.stat().st_mode
            target.chmod(mode | 0o111)
    return action


def seed_file(project: Path, dest: str, content: bytes, dry_run: bool, beside: str = None) -> str:
    """SEED disposition: write only when the dest is absent; never overwrite an
    existing file, even with --force (Decision 2a; SEED-ONCE-clobber dragon).

    `beside` is the legacy place of this seed when the project is in the new layout: a seed that is there
    and not at its new place is the project's own (a tier-1 ledger, or a product changelog), and a blank
    one created beside it is the failure the plan's C1 names. It is reported, not created."""
    target = project / dest
    if target.exists():
        return "present (seed; left as-is)"
    if beside is not None and (project / beside).exists():
        return f"not created: {beside} is at the root (seed; left as-is)"
    action = "would create" if dry_run else "created"
    if not dry_run:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(content)
        if dest.endswith(".py"):
            mode = target.stat().st_mode
            target.chmod(mode | 0o111)
    return action


def choose_layout(project: Path, requested: str) -> tuple:
    """(layout, how, refusal) for a sync of `project`: layout is "legacy" or "new" and `how` says why, or
    layout is None and `refusal` is the lines to print. Nothing here writes.

    The project's layout is read, never guessed (resolve_layout). `auto` keeps it; a project with no
    methodology files gets the legacy default. A request that disagrees with what is there would put a
    second runner beside the first (C1), and a tree that holds the runner in both places has no layout."""
    kind, _directory, found = resolve_layout(project)
    if kind == "half":
        return None, "", ([f"  ERROR: this project holds {found[0].name} in both places, so sync cannot tell which layout it is in:"]
                          + [f"    {p}" for p in found]
                          + ["",
                             "  Nothing was written. Remove or merge one of them by hand, then run sync again."])
    have = {"new": "new", "legacy": "legacy", "none": None}[kind]
    where = found[0].relative_to(project).as_posix() if found else ""
    if requested == "auto":
        if have:
            return have, f"found {where}", None
        return "legacy", "default: the project has no methodology files yet", None
    if have and have != requested:
        if have == "legacy":
            return None, "", [f"  ERROR: this project keeps its methodology files at its root (found {where}); --layout new would write",
                              "  a second set under methodology/, with a second runner beside the one an agent reads.",
                              "",
                              f"  Nothing was written. Move the project with {MIGRATE_TOOL} (a dry run until --apply),",
                              "  or sync without --layout, which keeps a project in the layout it has."]
        return None, "", [f"  ERROR: this project keeps its methodology files under methodology/ (found {where}); --layout legacy would",
                          "  write a second set at its root, with a second runner beside the one an agent reads.",
                          "",
                          "  Nothing was written. Sync without --layout, which keeps a project in the layout it has."]
    return requested, "requested", None


def main() -> int:
    p = argparse.ArgumentParser(description="Sync methodology starter-kit files into a project.")
    p.add_argument("project_path", help="Target project directory")
    p.add_argument("--mode", choices=("commit", "ignore"), help="commit (default) or ignore")
    p.add_argument("--source", choices=("local", "github"), help="local (default if sibling methodology/ exists), or github, "
                                                                 "which clones the repository for this run "
                                                                 "(needs git and network)")
    p.add_argument("--layout", choices=LAYOUTS, default="auto",
                   help="auto (default): keep the layout the project has, legacy for an empty one; legacy: files at the "
                        "project root; new: files under methodology/. A request that disagrees with the project is refused.")
    p.add_argument("--dry-run", action="store_true", help="Print intent without writing")
    p.add_argument("--force", action="store_true",
                   help="Overwrite files that show local modifications (not matching canonical or any historical version)")
    args = p.parse_args()

    project = Path(args.project_path).resolve()
    if not project.is_dir():
        sys.exit(f"error: {project} is not a directory")

    methodology_root = script_methodology_root()
    source = args.source or detect_source(methodology_root)
    if source == "local" and not (methodology_root / "starter-kit").is_dir():
        sys.exit(f"error: --source=local but no starter-kit/ at {methodology_root}")

    if source == "local":
        return sync_from(project, methodology_root, source, str(methodology_root), args)
    # github: a fresh clone, then exactly the local path over it. The clone lives only as long
    # as this run, dry run or not.
    url = source_url()
    with tempfile.TemporaryDirectory(prefix="methodology-sync-") as parent:
        clone = clone_source(url, Path(parent))
        local = DISTRIBUTION
        use_distribution(*source_distribution(clone, url))
        note_local_only(local, url)
        absent_sources(clone, url)
        return sync_from(project, clone, source, url, args)


def sync_from(project: Path, methodology_root: Path, source: str, origin: str, args) -> int:
    """Sync project from the methodology checkout at methodology_root: the repository this
    script lives in (--source=local) or a fresh clone of the source (--source=github). origin
    names where it came from, for the report: the checkout's path, or the URL cloned."""
    mode = args.mode or detect_mode(project)
    version = methodology_version(methodology_root)
    layout, how, refusal = choose_layout(project, args.layout)
    if layout == "new" and NEW_LAYOUT is None:
        sys.exit(f"error: the new layout needs a NEW_LAYOUT table in the source's bin/_manifest.py, and the one in {origin} "
                 f"has none: it predates the layout.\n"
                 f"hint: nothing was written. Sync from a checkout whose manifest has the table, or from a full "
                 f"local checkout with `--source=local`.")

    print(f"sync: {project}")
    print(f"  source:  {source} ({origin})")
    print(f"  mode:    {mode}")
    print(f"  version: {version}")
    if refusal:
        print("")
        print("\n".join(refusal))
        return 2
    print(f"  layout:  {layout} ({how})")
    if args.dry_run:
        print("  (dry-run: no changes will be written)")

    entries = []  # (src, dest, disposition, content, classification, beside)
    for src, legacy_dest, disp in DISTRIBUTION:
        dest = legacy_dest if layout == "legacy" else NEW_LAYOUT[src]
        content = read_local(methodology_root, src)
        target = project / dest
        beside = None
        if disp == SEED:
            # SEED files are adopter-owned; classification is only present/missing. In the new layout a seed
            # that sits at its legacy place and not at its new one is the project's own: not created beside.
            if target.exists():
                cls = "present"
            elif layout == "new" and (project / legacy_dest).exists():
                cls, beside = "present at root", legacy_dest
            else:
                cls = "missing"
        else:  # TRACKED
            cls = classify_target(target, content, local_history_blobs(methodology_root, src))
        entries.append((src, dest, disp, content, cls, beside))

    # Only TRACKED files can block: SEED files are never overwritten, so they
    # cannot be "modified" in the drift sense.
    blocked = [(src, dest) for src, dest, disp, _content, cls, _beside in entries
               if disp == TRACKED and cls == "modified"]
    if blocked and not args.force:
        # "Local modifications" is earned only by a source with its whole history; otherwise
        # say what the source lacks, which is what the adopter can fix.
        gap = history_gap(methodology_root, source)
        print("")
        if gap:
            print("  ERROR: the following files differ from the canonical version and would be overwritten:")
        else:
            print("  ERROR: the following files have local modifications that don't match")
            print("  any canonical or historical version and would be overwritten:")
        for _src, dest in blocked:
            print(f"    {dest}")
        print("")
        if gap:
            print("\n".join(gap))
            print("")
            print("  To proceed anyway and overwrite them, pass --force.")
        else:
            print("  The recommended pattern (see plan §3.2) is to move per-project")
            print("  customizations into CLAUDE.md's 'Project-Specific Methodology")
            print("  Adaptations' section, keeping synced files byte-identical to canonical.")
            print("")
            print("  To proceed anyway and overwrite local changes, pass --force.")
        if source == "local":
            print("  To inspect the drift first:")
            for src, dest in blocked:
                print(f"    diff {project / dest} {methodology_root / src}")
        else:
            # The clone is removed when this run ends, so the hint makes its own, at the commit read.
            sha = git_out(methodology_root, "rev-parse", "--short", "HEAD")
            where = f"methodology-{sha}"
            print("  To inspect the drift first, clone the source at the commit this run read:")
            print(f"    git clone {origin} {where} && git -C {where} checkout -q {sha}")
            for src, dest in blocked:
                print(f"    diff {project / dest} {where}/{src}")
        return 2

    file_results = []
    for src, dest, disp, content, _cls, beside in entries:
        if disp == SEED:
            result = seed_file(project, dest, content, args.dry_run, beside)
        else:
            result = sync_file(project, dest, content, args.dry_run)
        file_results.append((dest, result))

    print("  files:")
    for dest, result in file_results:
        print(f"    {dest}: {result}")

    if mode == "ignore":
        added = ensure_gitignore_entries(project, args.dry_run, layout)
        if added:
            verb = "would add" if args.dry_run else "added"
            print(f"  .gitignore: {verb} {', '.join(added)}")
        else:
            print("  .gitignore: entries already present")

        if (project / ".git").exists():
            tracked = currently_tracked(project, layout)
            if tracked:
                print("")
                print("  WARNING: the following files are currently tracked by git:")
                for f in tracked:
                    print(f"    {f}")
                print("  Run this to stop tracking them (keeps local copies):")
                print(f"    git -C {project} rm --cached {' '.join(tracked)}")
                print("  Then commit the removal. This script does not run it for you.")

    return 0


if __name__ == "__main__":
    sys.exit(main())
