#!/usr/bin/env python3
"""check-ledger — structural checks on a CHANGELOG.md action ledger.

The CHANGELOG.md counterpart of bin/check-handoff (parallel-sessions plan, Phase 1
Layer B). `merge=union` resolves a concurrent prepend without asking, so a merge that
went wrong is caught only by something that reads the result: this.

Checks, outside fenced blocks:
  * no merge-conflict markers survive;
  * every `### ` entry heading starts `### YYYY-MM-DD · ` and carries exactly ONE source
    tag from the closed vocabulary — [issue #<N>], [BL-<id>] or [ad hoc] — right after it;
  * no two entries share a heading (the trace of a doubled merge or a re-applied patch);
  * no orphaned body: below the first month heading or entry, a non-blank line belongs to
    an entry or is a heading (a footer after the last entry reads as that entry's tail, so
    it is accepted without a rule of its own);
  * the seed sentinel is gone once the ledger has an entry.

What it deliberately does NOT check: date order. A union merge puts ours above theirs, so
dates may run backwards across a merge, and that is accepted (prepend-only, never
re-sorted). A `### ` heading directly under the previous entry's last line, with the blank
line between them lost, is accepted for the same reason — that is what union produces.

Canonical-only (not in bin/_manifest.py), like check-handoff and check-learnings.
Exit: 0 clean · 1 findings · 2 usage or file missing.
"""
import argparse
import re
import subprocess
import sys
from pathlib import Path

HEADING_RE = re.compile(r"^### (\d{4}-\d{2}-\d{2}) · (.*)$")
TAG_RE = re.compile(r"\[(?:issue #\d+|BL-[^\]\s]+|ad hoc)\]")
SENTINEL = "METHODOLOGY-SEED-SENTINEL"
# The seed's sentinel is an HTML comment line; an entry that merely MENTIONS it in prose is not one.
SENTINEL_RE = re.compile(r"^\s*<!--\s*" + SENTINEL, re.MULTILINE)
CODE_SPAN_RE = re.compile(r"`[^`]*`")
MARKERS = ("<<<<<<< ", ">>>>>>> ", "|||||||")


def check(text: str) -> list:
    findings = []
    seen = {}
    fence = False
    zone = False      # past the front matter: the first `## ` month heading or `### ` entry
    in_entry = False
    entries = 0
    for n, line in enumerate(text.split("\n"), 1):
        if line.lstrip().startswith("```"):
            fence = not fence
            continue
        if fence:
            continue
        if line.startswith(MARKERS) or line == "=======":
            findings.append("%d: merge-conflict marker: %s" % (n, line[:60]))
            continue
        if line.startswith("### "):
            zone, in_entry = True, True
            entries += 1
            m = HEADING_RE.match(line)
            if not m:
                findings.append("%d: heading lacks the `### YYYY-MM-DD · ` prefix: %s" % (n, line[:90]))
            else:
                # A tag quoted in inline code (`[BL-<id>]`) is prose about tags, not a second tag.
                tags = TAG_RE.findall(CODE_SPAN_RE.sub("", m.group(2)))
                if len(tags) != 1:
                    findings.append("%d: %d source tags (want exactly one of [issue #<N>] | [BL-<id>] | "
                                    "[ad hoc]): %s" % (n, len(tags), line[:90]))
                elif not m.group(2).startswith(tags[0]):
                    findings.append("%d: the source tag must follow the date: %s" % (n, line[:90]))
            if line in seen:
                findings.append("%d: duplicate entry heading (first at line %d): %s" % (n, seen[line], line[:90]))
            else:
                seen[line] = n
            continue
        if line.startswith("## ") or line.startswith("# "):
            if line.startswith("## "):
                zone = True
            in_entry = False
            continue
        if zone and not in_entry and line.strip():
            findings.append("%d: orphaned text outside any entry: %s" % (n, line[:90]))
    if entries and SENTINEL_RE.search(text):
        findings.append("the seed sentinel (%s) is still present in a ledger with %d entr%s — delete it"
                        % (SENTINEL, entries, "y" if entries == 1 else "ies"))
    return findings


def repo_root() -> Path:
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True)
        return Path(out.stdout.strip())
    except (OSError, subprocess.CalledProcessError):
        return Path.cwd()


def main() -> int:
    ap = argparse.ArgumentParser(description="Structural checks on a CHANGELOG.md action ledger.")
    ap.add_argument("--file", help="ledger to check (default: CHANGELOG.md at the repository root)")
    ap.add_argument("--all", action="store_true",
                    help="also check the archived shards, docs/archive/CHANGELOG-*.md, beside the ledger")
    args = ap.parse_args()
    path = Path(args.file) if args.file else repo_root() / "CHANGELOG.md"
    if not path.is_file():
        print("check-ledger: no ledger at %s" % path, file=sys.stderr)
        return 2
    files = [path]
    if args.all:
        files += sorted((path.parent / "docs" / "archive").glob("CHANGELOG-*.md"))
    total = 0
    for f in files:
        findings = check(f.read_text(encoding="utf-8", errors="replace"))
        for msg in findings:
            print("%s:%s" % (f, msg) if msg[:1].isdigit() else "%s: %s" % (f, msg))
        total += len(findings)
    if total:
        print("check-ledger: %d finding(s) in %d file(s)" % (total, len(files)), file=sys.stderr)
        return 1
    print("check-ledger: OK — %d file(s), no structural findings" % len(files))
    return 0


if __name__ == "__main__":
    sys.exit(main())
